@page
@model Biblioteca.Pages.Livros.IndexModel

<h2>Livros</h2>

<a asp-page="/Livros/Create">Cadastrar</a> |
<a asp-page="/Livros/Index" asp-route-disponivel="true">Mostrar só disponíveis</a> |
<a asp-page="/Livros/Index">Mostrar todos</a>

<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Autor</th>
            <th>Disponível</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var livro in Model.Livros)
        {
            <tr>
                <td>@livro.Titulo</td>
                <td>@livro.Autor</td>
                <td>@(livro.Disponivel ? "Sim" : "Não")</td>
                <td>
                    <a asp-page="/Livros/Edit" asp-route-id="@livro.Id">Editar</a>
                    <a asp-page="/Livros/Delete" asp-route-id="@livro.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
