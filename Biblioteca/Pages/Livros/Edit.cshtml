@page
@model Biblioteca.Pages.Livros.EditModel

<div class="tw-flex tw-flex-col tw-items-center tw-py-8">

    <h1 class="tw-text-3xl tw-font-bold tw-text-gray-800 tw-mb-8">Editar Livro</h1>

    <div class="tw-bg-white tw-rounded-lg tw-shadow-md tw-p-8 tw-w-full tw-max-w-md">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="tw-bg-red-50 tw-border tw-border-red-200 tw-text-red-700 tw-p-4 tw-rounded-lg tw-mb-6">
                <h4 class="tw-font-semibold tw-mb-2">Erros encontrados:</h4>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="Id"/>

            <div class="tw-mb-6">
                <label asp-for="Titulo" class="tw-block tw-text-sm tw-font-semibold tw-text-gray-700 tw-mb-2"></label>
                <input asp-for="Titulo" class="tw-w-full tw-px-4 tw-py-2 tw-border tw-border-gray-300 tw-rounded-lg focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-blue-500"/>
                <span asp-validation-for="Titulo" class="tw-text-red-600 tw-text-sm tw-mt-1 tw-block"></span>
            </div>

            <div class="tw-mb-6">
                <label asp-for="Autor" class="tw-block tw-text-sm tw-font-semibold tw-text-gray-700 tw-mb-2"></label>
                <input asp-for="Autor" class="tw-w-full tw-px-4 tw-py-2 tw-border tw-border-gray-300 tw-rounded-lg focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-blue-500"/>
                <span asp-validation-for="Autor" class="tw-text-red-600 tw-text-sm tw-mt-1 tw-block"></span>
            </div>

            <div class="tw-mb-8 tw-flex tw-items-center">
                <input type="checkbox" asp-for="Disponivel" class="tw-w-4 tw-h-4 tw-cursor-pointer"/>
                <label asp-for="Disponivel" class="tw-ml-2 tw-text-sm tw-font-semibold tw-text-gray-700 tw-cursor-pointer"></label>
                <span asp-validation-for="Disponivel" class="tw-text-red-600 tw-text-sm tw-ml-2"></span>
            </div>

            <div class="tw-flex tw-gap-3">
                <button type="submit" class="tw-flex-1 tw-bg-blue-500 hover:tw-bg-blue-600 !tw-text-white tw-px-4 tw-py-2 tw-rounded-lg tw-font-semibold tw-transition-colors tw-cursor-pointer">
                    Salvar alterações
                </button>
                <a asp-page="/Livros/Index" class="tw-flex-1 tw-bg-gray-400 hover:tw-bg-gray-500 !tw-text-white tw-px-4 tw-py-2 tw-rounded-lg tw-font-semibold tw-transition-colors tw-cursor-pointer tw-text-center tw-flex tw-items-center tw-justify-center">
                    Voltar
                </a>
            </div>
        </form>
    </div>

</div>