@page
@model Biblioteca.Pages.Livros.EditModel
@{
}

<h2>Editar livro</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">
    <input type="hidden" asp-for="Id"/>

    <label asp-for="Titulo"></label>
    <input asp-for="Titulo"/>
    <span asp-validation-for="Titulo" class="text-danger"></span>

    <label asp-for="Autor"></label>
    <input asp-for="Autor"/>
    <span asp-validation-for="Autor" class="text-danger"></span>

    <label asp-for="Disponivel"></label>
    <input type="checkbox" asp-for="Disponivel"/>

    <button type="submit">Salvar alterações</button>

</form>

<a asp-page="/Livros/Index">Voltar</a>