@page
@model Biblioteca.Pages.Retiradas.ReturnCreateModel

<div class="tw-flex tw-flex-col tw-items-center tw-py-8">

    <h1 class="tw-text-3xl tw-font-bold tw-text-gray-800 tw-mb-8">Registrar Devolução de Livro</h1>

    <div class="tw-bg-white tw-rounded-lg tw-shadow-md tw-p-6 tw-w-full tw-max-w-2xl tw-mb-6">
        <h3 class="tw-text-lg tw-font-semibold tw-text-gray-800 tw-mb-4">Filtrar Retiradas</h3>

        <form method="get" class="tw-flex tw-gap-4">
            <div class="tw-flex-1">
                <label class="tw-block tw-text-sm tw-font-semibold tw-text-gray-700 tw-mb-2">Autor</label>
                <select name="FiltroAutor" class="tw-w-full tw-px-4 tw-py-2 tw-border tw-border-gray-300 tw-rounded-lg focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-blue-500">
                    <option value="">Todos os autores</option>
                    @foreach (var autor in Model.Autores)
                    {
                        <option value="@autor" selected="@(Model.FiltroAutor == autor ? "selected" : null)">@autor</option>
                    }
                </select>
            </div>

            <div class="tw-flex-1">
                <label class="tw-block tw-text-sm tw-font-semibold tw-text-gray-700 tw-mb-2">Usuário</label>
                <select name="FiltroUsuarioId" class="tw-w-full tw-px-4 tw-py-2 tw-border tw-border-gray-300 tw-rounded-lg focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-blue-500">
                    <option value="">Todos os usuários</option>
                    @foreach (var usuario in Model.UsuariosSelectList)
                    {
                        <option value="@usuario.Value" selected="@(Model.FiltroUsuarioId?.ToString() == usuario.Value ? "selected" : null)">@usuario.Text</option>
                    }
                </select>
            </div>

            <div class="tw-flex tw-items-end">
                <button type="submit" class="tw-bg-blue-500 hover:tw-bg-blue-600 !tw-text-white tw-px-6 tw-py-2 tw-rounded-lg tw-font-semibold tw-transition-colors tw-cursor-pointer tw-h-10">
                    Filtrar
                </button>
            </div>
        </form>
    </div>

    <div class="tw-bg-white tw-rounded-lg tw-shadow-md tw-p-8 tw-w-full tw-max-w-2xl">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="tw-bg-red-50 tw-border tw-border-red-200 tw-text-red-700 tw-p-4 tw-rounded-lg tw-mb-6">
                <h4 class="tw-font-semibold tw-mb-2">Erros encontrados:</h4>
                <div asp-validation-summary="All"></div>
            </div>
        }

        @if (Model.RetiradasAtivas.Count == 0)
        {
            <div class="tw-bg-blue-50 tw-border tw-border-blue-200 tw-text-blue-700 tw-p-4 tw-rounded-lg tw-mb-6">
                <p class="tw-font-semibold">ℹ️ Não há livros para devolver com os filtros selecionados.</p>
            </div>
        }
        else
        {
            <form method="post">
                <!-- Campo Seleção de Retirada -->
                <div class="tw-mb-8">
                    <label class="tw-block tw-text-sm tw-font-semibold tw-text-gray-700 tw-mb-4">
                        Selecione o livro para devolver
                        <span class="tw-text-gray-500 tw-font-normal">(@Model.RetiradasAtivas.Count encontrado@(Model.RetiradasAtivas.Count != 1 ? "s" : ""))</span>
                    </label>

                    <div class="tw-space-y-3 tw-max-h-96 tw-overflow-y-auto">
                        @foreach (var retirada in Model.RetiradasAtivas)
                        {
                            <label class="tw-flex tw-items-start tw-p-4 tw-border tw-border-gray-300 tw-rounded-lg hover:tw-bg-gray-50 tw-cursor-pointer tw-transition-colors">
                                <input type="radio"
                                       asp-for="SelecionaRetiradaId"
                                       value="@retirada.Id"
                                       class="tw-w-4 tw-h-4 tw-mt-1 tw-cursor-pointer" />

                                <div class="tw-ml-4 tw-flex-1">
                                    <p class="tw-font-semibold tw-text-gray-800">@retirada.Livro.Titulo</p>
                                    <p class="tw-text-sm tw-text-gray-600">@retirada.Livro.Autor</p>
                                    <p class="tw-text-sm tw-text-gray-500">Retirado por: @retirada.Usuario.Nome</p>
                                    <p class="tw-text-xs tw-text-gray-500">Data da retirada: @retirada.DataRetirada.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Botões -->
                <div class="tw-flex tw-gap-3">
                    <button type="submit" class="tw-flex-1 tw-bg-green-500 hover:tw-bg-green-600 !tw-text-white tw-px-4 tw-py-2 tw-rounded-lg tw-font-semibold tw-transition-colors tw-cursor-pointer">
                        Confirmar Devolução
                    </button>
                    <a asp-page="/Retiradas/Index" class="tw-flex-1 tw-bg-gray-400 hover:tw-bg-gray-500 !tw-text-white tw-px-4 tw-py-2 tw-rounded-lg tw-font-semibold tw-transition-colors tw-cursor-pointer tw-text-center tw-flex tw-items-center tw-justify-center tw-no-underline">
                        Voltar
                    </a>
                </div>
            </form>
        }
    </div>

</div>